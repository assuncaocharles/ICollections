{
	"name": "icollections",
	"version": "0.0.0-development",
	"description": "Strictly typed, dependency-free data structures for TypeScript",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json && tsc -p site/tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint:package": "publint --strict",
		"prepublishOnly": "npm run typecheck && npm test && npm run build && npm run lint:package",
		"build:site": "npm run build && node site/build.mjs",
		"dev:site": "npm run build && node site/build.mjs --serve"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/assuncaocharles/ICollections.git"
	},
	"author": "Charles Assunção",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/assuncaocharles/ICollections/issues"
	},
	"homepage": "https://assuncaocharles.github.io/ICollections/",
	"keywords": [
		"data structures",
		"collections",
		"generic",
		"typescript",
		"stack",
		"linked list",
		"map",
		"queue",
		"tree",
		"binary search tree",
		"priority queue",
		"heap",
		"set",
		"hash table"
	],
	"devDependencies": {
		"@vitest/coverage-v8": "^5.1.2",
		"esbuild": "^0.28.2",
		"highlight.js": "^11.12.0",
		"marked": "^18.3.0",
		"prettier": "^3.10.1",
		"publint": "^0.3.25",
		"sucrase": "^3.35.1",
		"typescript": "^7.0.2",
		"vitest": "^5.1.2"
	}
}
